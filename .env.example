# Copy to .env and fill in. Never commit .env.

# Port on 127.0.0.1 that the server's Cloudflare Tunnel points at:
# public hostname adsb.<your-domain> → http://localhost:<HOST_PORT>
# HOST_PORT=8790

# The public URL you open on your phone. Used for links in notifications and the CSRF origin check.
PUBLIC_URL=https://adsb.example.com

# Optional: a fixed first-run setup token. If empty, a random one is printed in the container log.
SETUP_TOKEN=

# Optional: ntfy notifications (see docs/NTFY.md). You can also set these in the web UI (Settings).
# NTFY_URL=https://ntfy.example.com
# NTFY_TOPIC=planes-a1b2c3d4e5
# NTFY_TOKEN=tk_your_publish_token

# Optional live sources (docs/SOURCES.md). Each is used only when its settings are present.
# FLYITALY_API_KEY=your-flyitalyadsb-key
# OpenSky: an API client from your account page (OAuth2 client credentials).
# OPENSKY_CLIENT_ID=your-client-id
# OPENSKY_CLIENT_SECRET=your-client-secret
# OPENSKY_DAILY_CREDITS=4000          # 8000 if you're an active OpenSky feeder
# Your own receiver (readsb/ultrafeeder) on the LAN, read every second. Use an IP address or a
# DNS name: mDNS names like pi.local usually don't resolve inside a container.
# RECEIVER_URL=http://192.168.1.50/tar1090/data/aircraft.json
# RECEIVER_UAT_URL=http://192.168.1.50/skyaware978/data/aircraft.json   # optional, 978 MHz UAT
# RECEIVER_INTERVAL_S=1

# Advanced
# LOG_LEVEL=INFO
# TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# AUTH_MODE=builtin
